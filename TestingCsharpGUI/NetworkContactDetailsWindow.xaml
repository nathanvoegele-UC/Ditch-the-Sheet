<Window x:Class="TestingCsharpGUI.NetworkContactDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Networking contact details" Height="590" Width="460"
        MinHeight="500" MinWidth="390" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" Background="#F4F6F8">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="DetailLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#788594"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="DetailValue">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#263342"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Networking contact" FontSize="21" FontWeight="Bold" Foreground="#263342"/>
            <TextBlock Text="Contact information and notes."
                       Foreground="#788594" Margin="0,5,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Background="White" BorderBrush="#E2E7EC" BorderThickness="1"
                    CornerRadius="5" Padding="16">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold"
                               Foreground="#263342" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <TextBlock Text="Company" Style="{StaticResource DetailLabel}"/>
                    <TextBlock Text="{Binding Company, TargetNullValue=—}" Style="{StaticResource DetailValue}" Margin="0,3,0,14"/>
                    <TextBlock Text="Position" Style="{StaticResource DetailLabel}"/>
                    <TextBlock Text="{Binding Position, TargetNullValue=—}" Style="{StaticResource DetailValue}" Margin="0,3,0,14"/>
                    <TextBlock Text="Email" Style="{StaticResource DetailLabel}"/>
                    <TextBlock Text="{Binding Email, TargetNullValue=—}" Style="{StaticResource DetailValue}" Margin="0,3,0,14"/>
                    <TextBlock Text="Phone number" Style="{StaticResource DetailLabel}"/>
                    <TextBlock Text="{Binding PhoneNumber, TargetNullValue=—}" Style="{StaticResource DetailValue}" Margin="0,3,0,14"/>
                    <TextBlock Text="LinkedIn URL" Style="{StaticResource DetailLabel}"/>
                    <TextBlock Text="{Binding LinkedInUrl, TargetNullValue=—}" Style="{StaticResource DetailValue}" Margin="0,3,0,14"/>
                    <TextBlock Text="Notes" Style="{StaticResource DetailLabel}"/>
                    <TextBlock Text="{Binding Notes, TargetNullValue=—}" Style="{StaticResource DetailValue}" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
        <Button Grid.Row="2" Content="Close" IsCancel="True" Padding="14,7"
                HorizontalAlignment="Right" Margin="0,16,0,0"/>
    </Grid>
</Window>
