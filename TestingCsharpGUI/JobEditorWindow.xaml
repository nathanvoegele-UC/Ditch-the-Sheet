<Window x:Class="TestingCsharpGUI.JobEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add job application" Height="650" Width="480"
        MinHeight="600" MinWidth="420" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F4F6F8">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="BorderBrush" Value="#DCE2E8"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Add job application" FontSize="22" FontWeight="Bold" Foreground="#263342"/>
            <TextBlock Text="Enter the job details to add it to your workspace." Foreground="#788594" Margin="0,5,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Company *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="CompanyInput" Margin="0,0,0,13"/>
                <TextBlock Text="Role *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="RoleInput" Margin="0,0,0,13"/>
                <TextBlock Text="Location" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="LocationInput" Margin="0,0,0,13"/>
                <TextBlock Text="Work mode" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox x:Name="WorkModeInput" Margin="0,0,0,13"/>
                <TextBlock Text="Pay type" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox x:Name="PayTypeInput" Margin="0,0,0,13"
                          SelectionChanged="PayTypeInput_SelectionChanged"/>
                <TextBlock x:Name="PayAmountLabel" Text="Yearly salary (USD)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="PayAmountInput" Margin="0,0,0,13"/>
                <TextBlock Text="Date applied" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <DatePicker x:Name="DateAppliedInput" Margin="0,0,0,13"/>
                <TextBlock Text="Status" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox x:Name="StatusInput" Margin="0,0,0,13"/>
                <TextBlock Text="Interview date (optional)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <DatePicker x:Name="InterviewDateInput" Margin="0,0,0,13"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="14,7" Margin="0,0,8,0"/>
            <Button Content="Save application" IsDefault="True" Padding="14,7"
                    Background="#2878D0" Foreground="White" BorderBrush="#2878D0"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
