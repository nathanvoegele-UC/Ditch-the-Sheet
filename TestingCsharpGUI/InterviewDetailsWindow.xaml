<Window x:Class="TestingCsharpGUI.InterviewDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Interview details" Height="560" Width="440"
        MinHeight="480" MinWidth="380" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" Background="#F4F6F8">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="DetailLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#788594"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="DetailValue">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#263342"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Interview details" FontSize="21" FontWeight="Bold" Foreground="#263342"/>
            <TextBlock Text="Review the scheduled interview and job information."
                       Foreground="#788594" Margin="0,5,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="#EAF3FC" CornerRadius="5" Padding="14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding Company}" FontSize="20" FontWeight="Bold"
                                   Foreground="#263342" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Role}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="#344255" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#E2E7EC" BorderThickness="1"
                        CornerRadius="5" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Interview date" Style="{StaticResource DetailLabel}"/>
                        <TextBlock Text="{Binding InterviewDate, StringFormat={}{0:D}, TargetNullValue=Date not set}"
                                   Style="{StaticResource DetailValue}" Margin="0,3,0,14"/>
                        <TextBlock Text="Interview time" Style="{StaticResource DetailLabel}"/>
                        <TextBlock Text="{Binding InterviewTimeDisplay}" Style="{StaticResource DetailValue}" Margin="0,3,0,14"/>
                        <TextBlock Text="Status" Style="{StaticResource DetailLabel}"/>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource DetailValue}" Margin="0,3,0,14"/>
                        <TextBlock Text="Location" Style="{StaticResource DetailLabel}"/>
                        <TextBlock Text="{Binding LocationDisplay}" Style="{StaticResource DetailValue}" Margin="0,3,0,14"/>
                        <TextBlock Text="Work mode" Style="{StaticResource DetailLabel}"/>
                        <TextBlock Text="{Binding WorkMode}" Style="{StaticResource DetailValue}" Margin="0,3,0,14"/>
                        <TextBlock Text="Pay" Style="{StaticResource DetailLabel}"/>
                        <TextBlock Text="{Binding PayDisplay}" Style="{StaticResource DetailValue}" Margin="0,3,0,14"/>
                        <TextBlock Text="Date applied" Style="{StaticResource DetailLabel}"/>
                        <TextBlock Text="{Binding DateAppliedDisplay}" Style="{StaticResource DetailValue}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <Button Content="Remove interview" Padding="12,7"
                    Background="#FFF1F0" Foreground="#B42318" BorderBrush="#F4C7C3"
                    Click="RemoveInterview_Click"/>
            <Button Content="Close" IsCancel="True" Padding="14,7"
                    HorizontalAlignment="Right" DockPanel.Dock="Right"/>
        </DockPanel>
    </Grid>
</Window>
