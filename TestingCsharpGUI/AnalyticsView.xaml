<UserControl x:Class="TestingCsharpGUI.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#263342"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#788594"/>
    </UserControl.Resources>
    <Grid Background="#F4F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Application analytics" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="Track the number of job applications over time."
                       Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E7EC" BorderThickness="1"
                CornerRadius="5" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Applications sent" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock x:Name="ChartSummary" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,4,0,0"/>
                        <TextBlock x:Name="WeeklyGoalText" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Top" HorizontalAlignment="Right">
                        <ComboBox x:Name="PeriodSelector" Width="120" Height="34"
                                  VerticalAlignment="Center" SelectedIndex="0" Margin="0,0,8,0"
                                  SelectionChanged="PeriodSelector_SelectionChanged">
                            <ComboBoxItem Content="By day"/>
                            <ComboBoxItem Content="By week"/>
                            <ComboBoxItem Content="By month"/>
                        </ComboBox>
                        <Button Content="Change weekly goal" Padding="12,7"
                                Background="#2878D0" Foreground="White" BorderBrush="#2878D0"
                                FontWeight="SemiBold" Click="ChangeWeeklyGoal_Click"/>
                    </StackPanel>
                </DockPanel>
                <Grid Grid.Row="1">
                    <Canvas x:Name="ChartCanvas" SizeChanged="ChartCanvas_SizeChanged"/>
                    <TextBlock x:Name="EmptyState"
                               Text="No applications to chart yet. Add a job with a date applied."
                               Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320"
                               IsHitTestVisible="False"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
