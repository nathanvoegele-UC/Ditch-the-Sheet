<Window x:Class="TestingCsharpGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TestingCsharpGUI"
        Loaded="MainWindow_Loaded"
        Title="Ditch the Sheet" Height="820" Width="1440"
        MinHeight="680" MinWidth="1080"
        Background="#F4F6F8" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2878D0"/>
        <SolidColorBrush x:Key="TextBrush" Color="#263342"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#788594"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#344255"/>
            <Setter Property="BorderBrush" Value="#DCE2E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2878D0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2878D0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="BorderBrush" Value="#DCE2E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="BorderBrush" Value="#DCE2E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="205"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E1E6EB" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,18">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="DITCH THE SHEET" FontSize="17" FontWeight="Bold" Foreground="#2878D0" Margin="5,0,0,5"/>
                    <TextBlock Text="Personal job workspace" FontSize="11" Foreground="#8793A0" Margin="5,0,0,22"/>
                    <Button x:Name="AllJobsNavButton" Content="▤   All jobs" Tag="All" Click="Navigation_Click"
                            HorizontalContentAlignment="Left" Margin="0,0,0,5" BorderThickness="0" Background="#EAF3FC" Foreground="#2878D0"/>
                    <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="SemiBold" Foreground="#8A96A4" Margin="7,20,0,7"/>
                    <Button x:Name="InterviewsNavButton" Content="◷   Interviews" Tag="Interviews" Click="Navigation_Click"
                            HorizontalContentAlignment="Left" Margin="0,0,0,5" BorderThickness="0" Background="Transparent"/>
                    <Button x:Name="SavedNavButton" Content="☆   Saved for later" Tag="Saved" Click="Navigation_Click"
                            HorizontalContentAlignment="Left" Margin="0,0,0,5" BorderThickness="0" Background="Transparent"/>
                    <Button x:Name="NetworkNavButton" Content="♧   Network Tracking" Tag="Network" Click="Navigation_Click"
                            HorizontalContentAlignment="Left" Margin="0,0,0,5" BorderThickness="0" Background="Transparent"/>
                    <Button x:Name="DataNavButton" Content="△   Job Analytics" Tag="Data" Click="Navigation_Click"
                            HorizontalContentAlignment="Left" Margin="0,0,0,5" BorderThickness="0" Background="Transparent"/>        
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Background="#F6F8FA" BorderBrush="#E2E7EC" BorderThickness="1" CornerRadius="5" Padding="10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,7">
                            <TextBlock Text="Weekly goal" FontWeight="SemiBold" Foreground="#344255"/>
                            <TextBlock x:Name="WeeklyGoalText" DockPanel.Dock="Right" Text="0 / 5" Foreground="#2878D0"/>
                        </DockPanel>
                        <ProgressBar x:Name="WeeklyGoalProgress" Height="5" Minimum="0" Maximum="5" Value="0"/>
                        <TextBlock Text="Applications sent this week" FontSize="10" Foreground="#8793A0" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="26,20,26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="All jobs" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Find opportunities, track applications, and plan your next move." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button x:Name="ExportButton" Content="Export" Click="Export_Click" Margin="0,0,8,0"/>
                    <Button x:Name="AddJobButton" Content="+  Add job" Style="{StaticResource PrimaryButton}" Click="AddJob_Click"/>
                </StackPanel>
            </DockPanel>

            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,20">
                <Border Background="White" BorderBrush="#E2E7EC" BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Jobs in your workspace" Foreground="{StaticResource MutedBrush}"/>
                        <DockPanel Margin="0,5,0,0"><TextBlock x:Name="TotalJobsText" Text="0" FontSize="23" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/><TextBlock Text=" all applications" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="7,0,0,3"/></DockPanel>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#E2E7EC" BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Saved for later" Foreground="{StaticResource MutedBrush}"/>
                        <DockPanel Margin="0,5,0,0"><TextBlock x:Name="SavedJobsText" Text="0" FontSize="23" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/><TextBlock Text=" jobs to apply" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="7,0,0,3"/></DockPanel>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#E2E7EC" BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Applications sent" Foreground="{StaticResource MutedBrush}"/>
                        <DockPanel Margin="0,5,0,0"><TextBlock x:Name="ApplicationsThisWeekText" Text="0" FontSize="23" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/><TextBlock Text=" this week" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="7,0,0,3"/></DockPanel>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#E2E7EC" BorderThickness="1" CornerRadius="5" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Upcoming interviews" Foreground="{StaticResource MutedBrush}"/>
                        <DockPanel Margin="0,5,0,0"><TextBlock x:Name="UpcomingInterviewsText" Text="0" FontSize="23" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/><TextBlock Text=" scheduled" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="7,0,0,3"/></DockPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid x:Name="AllJobsContent" Grid.Row="2" Grid.RowSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
            <Border x:Name="JobsFilterPanel" Grid.Row="0" Background="White" BorderBrush="#E2E7EC" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Job listings" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <TextBlock x:Name="ResultsCountText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,12,0"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,9">
                        <Button Content="Search" Style="{StaticResource PrimaryButton}" Click="Search_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                        <TextBox x:Name="SearchTextBox" TextChanged="SearchTextBox_TextChanged" ToolTip="Search company, role, or location"/>
                    </DockPanel>
                    <WrapPanel>
                        <ComboBox x:Name="LocationFilter" Width="175" Margin="0,0,8,0" SelectionChanged="Filter_SelectionChanged"/>
                        <ComboBox x:Name="WorkModeFilter" Width="145" Margin="0,0,8,0" SelectionChanged="Filter_SelectionChanged"/>
                        <ComboBox x:Name="SalaryFilter" Width="145" Margin="0,0,8,0" SelectionChanged="Filter_SelectionChanged"/>
                        <ComboBox x:Name="StatusFilter" Width="140" Margin="0,0,8,0" SelectionChanged="Filter_SelectionChanged"/>
                        <Button Content="Reset filters" Click="ResetFilters_Click" Padding="9,5"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Grid x:Name="JobsContentGrid" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="0"/>
                </Grid.ColumnDefinitions>
            <Border x:Name="JobsTablePanel" Grid.Column="0" Background="White" BorderBrush="#E2E7EC" BorderThickness="1" CornerRadius="5" Padding="1">
                <DataGrid x:Name="JobsDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          BorderThickness="0" RowHeight="44" AlternatingRowBackground="#FBFCFD"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          SelectionChanged="JobsDataGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="CompanyColumn" Header="Company" Binding="{Binding Company}" Width="1.1*"/>
                        <DataGridTextColumn x:Name="RoleColumn" Header="Role" Binding="{Binding Role}" Width="1.6*"/>
                        <DataGridTextColumn Header="Location" Binding="{Binding LocationDisplay}" Width="1.2*"/>
                        <DataGridTextColumn x:Name="WorkModeColumn" Header="Work mode" Binding="{Binding WorkMode}" Width="0.8*"/>
                        <DataGridTextColumn Header="Pay" Binding="{Binding PayDisplay}" Width="0.9*"/>
                        <DataGridTextColumn Header="Date applied" Binding="{Binding DateAppliedDisplay}" Width="0.9*"/>
                        <DataGridTextColumn Header="Networking Contact" Binding="{Binding NetworkContactName}" Width="1.1*"/>
                        <DataGridTemplateColumn Header="Status" Width="1*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=StatusOptions}"
                                              SelectedItem="{Binding Status, Mode=TwoWay}"
                                              SelectionChanged="Status_SelectionChanged"
                                              Padding="5,2" MinHeight="27" BorderThickness="0"
                                              Background="Transparent"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border x:Name="JobDetailsPanel" Grid.Column="1" Visibility="Collapsed"
                    Background="White" BorderBrush="#E2E7EC" BorderThickness="1" CornerRadius="7"
                    Padding="16" Margin="12,0,0,0">
                <DockPanel LastChildFill="True">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <Button Content="×" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                Padding="8,3" MinWidth="30" FontSize="16" Click="CloseJobDetails_Click"/>
                        <TextBlock Text="Job details" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Button Content="Delete job" DockPanel.Dock="Bottom"
                            Background="#FFF1F0" Foreground="#B42318" BorderBrush="#F4C7C3"
                            FontWeight="SemiBold" Margin="0,14,0,0" Click="DeleteJob_Click"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding Company}" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Role}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" Margin="0,4,0,10"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding LocationDisplay}" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="Networking contact" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,14,0,5"/>
                            <ComboBox x:Name="JobContactSelector" DisplayMemberPath="Name"
                                      SelectedValuePath="Id" VerticalContentAlignment="Center"
                                      SelectionChanged="JobContact_SelectionChanged" Margin="0,0,0,5"/>
                            <Button x:Name="ViewLinkedContactButton" Content="{Binding NetworkContactName}"
                                    HorizontalContentAlignment="Left" Padding="0,3" Margin="0,0,0,12"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#2878D0" IsEnabled="{Binding HasLinkedContact}"
                                    Click="ViewLinkedContact_Click"/>
                            <DockPanel Margin="0,5,0,12">
                                <TextBlock Text="Applied " Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                <TextBlock Text="{Binding DateAppliedDisplay}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            </DockPanel>
                            <Border Background="#EAF3FC" CornerRadius="4" Padding="8,5"
                                    HorizontalAlignment="Left" Margin="0,0,0,16">
                                <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#2878D0"/>
                            </Border>
                            <Border BorderBrush="#E2E7EC" BorderThickness="0,1,0,0" Margin="0,0,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Grid.Column="0" Background="#F6F8FA"
                                        CornerRadius="4" Padding="9" Margin="0,0,6,6">
                                    <StackPanel>
                                        <TextBlock Text="Pay" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock Text="{Binding PayDisplay}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" Background="#F6F8FA"
                                        CornerRadius="4" Padding="9" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Work mode" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock Text="{Binding WorkMode}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" Margin="0,3,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="0" Background="#F6F8FA"
                                        CornerRadius="4" Padding="9" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="Interview date" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock Text="{Binding InterviewDate, StringFormat={}{0:d}, TargetNullValue=—}"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Background="#F6F8FA"
                                        CornerRadius="4" Padding="9">
                                    <StackPanel>
                                        <TextBlock Text="Interview time" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock Text="{Binding InterviewTimeDisplay}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" Margin="0,3,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            </Grid>
            </Grid>

            <local:SavedJobsView x:Name="SavedJobsContent" Grid.Row="2" Grid.RowSpan="2"
                                 Visibility="Collapsed"/>
            <local:InterviewsView x:Name="InterviewsContent" Grid.Row="2" Grid.RowSpan="2"
                                  Visibility="Collapsed"/>
            <local:NetworkTrackingView x:Name="NetworkTrackingContent" Grid.Row="2" Grid.RowSpan="2"
                                       Visibility="Collapsed"/>
            <local:AnalyticsView x:Name="AnalyticsContent" Grid.Row="2" Grid.RowSpan="2"
                                 Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>