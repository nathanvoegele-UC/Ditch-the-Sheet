<Window x:Class="TestingCsharpGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TestingCsharpGUI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel Margin="20" VerticalAlignment="Center">
    <Label Content="Enter your name:" FontSize="14" FontWeight="Bold"/>
    <TextBox x:Name="txtName" FontSize="14" Margin="0,5,0,15" Padding="5"/>
    <Button x:Name="btnSubmit" Content="Greet Me" FontSize="14" Padding="10,5" Click="btnSubmit_Click"/>
</StackPanel>

</Window>
