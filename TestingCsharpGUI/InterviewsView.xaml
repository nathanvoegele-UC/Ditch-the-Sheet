<UserControl x:Class="TestingCsharpGUI.InterviewsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <UserControl.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#263342"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#788594"/>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2878D0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2878D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>
    <Border Background="White" BorderBrush="#E2E7EC" BorderThickness="1"
            CornerRadius="5" Padding="18">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <TextBlock Text="Interview calendar" FontSize="40" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}"
                           Margin="0,0,0,12"/>
                <Viewbox Width="500" Height="430" Stretch="Fill">
                    <Calendar x:Name="InterviewCalendar" SelectionMode="SingleDate"
                              SelectedDatesChanged="InterviewCalendar_SelectedDatesChanged"
                              FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                </Viewbox>
            </StackPanel>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="Schedule an interview" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Choose a job and a date on the calendar."
                               Foreground="{StaticResource MutedBrush}" Margin="0,4,0,10"/>
                    <ComboBox x:Name="InterviewJobSelector" VerticalContentAlignment="Center" Margin="0,0,0,8">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Company}" FontWeight="SemiBold"/>
                                    <TextBlock Text=" — " Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding Role}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <DockPanel>
                        <Button Content="Schedule" Style="{StaticResource PrimaryButton}"
                                Click="ScheduleInterview_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                        <ComboBox x:Name="InterviewTimeSelector" VerticalContentAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
                <TextBlock x:Name="InterviewDayHeading" Grid.Row="1" FontSize="15"
                           FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                <Grid Grid.Row="2">
                    <ListBox x:Name="InterviewList" BorderThickness="0" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E2E7EC" BorderThickness="0,0,0,1" Padding="8">
                                    <DockPanel LastChildFill="True">
                                        <Button Content="Remove" DockPanel.Dock="Right" Padding="8,4"
                                                Margin="8,0,0,0" VerticalAlignment="Center"
                                                Click="RemoveInterview_Click"/>
                                        <Button Click="OpenInterviewDetails_Click" Background="Transparent"
                                                BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch">
                                            <StackPanel HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Company}" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock Text="{Binding Role}" Foreground="{StaticResource MutedBrush}"
                                                           Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding InterviewTimeDisplay}" FontSize="12"
                                                           FontWeight="SemiBold" Foreground="#2878D0" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding LocationDisplay}" FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="NoInterviewsText" Text="No interviews scheduled for this date."
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" TextWrapping="Wrap" IsHitTestVisible="False"/>
                </Grid>
                <Border Grid.Row="3" Background="#F6F8FA" BorderBrush="#E2E7EC"
                        BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="Upcoming interviews" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock x:Name="UpcomingInterviewCountText" DockPanel.Dock="Right"
                                       Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                        </DockPanel>
                        <Grid Grid.Row="1">
                            <ListBox x:Name="UpcomingInterviewsList" BorderThickness="0"
                                     Background="Transparent" HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E2E7EC" BorderThickness="0,0,0,1" Padding="7,5">
                                            <Button Click="OpenInterviewDetails_Click" Background="Transparent"
                                                    BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch">
                                                <DockPanel LastChildFill="True">
                                                    <StackPanel DockPanel.Dock="Left" Width="92"
                                                                HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding InterviewDateDisplay}" FontSize="11"
                                                                   FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                                        <TextBlock Text="{Binding InterviewTimeDisplay}" FontSize="10"
                                                                   Foreground="#2878D0" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding Company}" FontSize="11"
                                                                   FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                                        <TextBlock Text="{Binding Role}" FontSize="10"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Button>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="NoUpcomingInterviewsText"
                                       Text="No upcoming interviews scheduled."
                                       Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="Wrap" IsHitTestVisible="False"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
